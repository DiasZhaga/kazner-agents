# Copy to .env and fill in. .env is gitignored; never commit a real key.
OPENAI_API_KEY=

# Model and reasoning effort for the LLMAnnotator (see DESIGN.md section 6)
KNA_MODEL=gpt-6-luna
KNA_REASONING_EFFORT=low

# Prices in USD per 1M tokens, used only for the cost estimate after a run
KNA_PRICE_INPUT_PER_1M=0.10
KNA_PRICE_OUTPUT_PER_1M=0.50

# Run limits (DESIGN.md section 7)
KNA_MAX_STEPS=60
KNA_MAX_SECONDS=300
KNA_LLM_TIMEOUT_SECONDS=60
KNA_MAX_LLM_CALLS=40

# Wikimedia asks every client for a descriptive User-Agent with a contact
KNA_USER_AGENT=kazner-agents/0.1 (course project; contact: your-email@example.com)
